{
  "openapi": "3.0.3",
  "info": {
    "title": "TCC2 I/O workload",
    "version": "1.0.0"
  },
  "paths": {
    "/io": {
      "post": {
        "operationId": "executeIo",
        "tags": [
          "I/O workload"
        ],
        "summary": "Read item and category, append one access event",
        "description": "Two separate reads and one insert in a READ COMMITTED transaction. HTTP 200 is produced after commit.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IoRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Access committed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IoResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorInfo"
                }
              }
            }
          },
          "404": {
            "description": "Item not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorInfo"
                }
              }
            }
          },
          "409": {
            "description": "Duplicate run/request pair",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorInfo"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorInfo"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorInfo"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "IoRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "itemId",
          "runId",
          "requestId"
        ],
        "properties": {
          "itemId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "runId": {
            "type": "string",
            "format": "uuid"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "IoResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item",
          "category",
          "event"
        ],
        "properties": {
          "item": {
            "$ref": "#/components/schemas/CatalogItemResponse"
          },
          "category": {
            "$ref": "#/components/schemas/CategoryResponse"
          },
          "event": {
            "$ref": "#/components/schemas/AccessEventResponse"
          }
        }
      },
      "CatalogItemResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "categoryId",
          "sku",
          "name",
          "description",
          "brand",
          "model",
          "price",
          "currency",
          "weightGrams",
          "status",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "categoryId": {
            "type": "integer",
            "format": "int64"
          },
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "multipleOf": 0.01
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "weightGrams": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CategoryResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "slug",
          "description",
          "displayOrder",
          "active",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "displayOrder": {
            "type": "integer",
            "minimum": 0
          },
          "active": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AccessEventResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "itemId",
          "runId",
          "requestId",
          "eventType",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "itemId": {
            "type": "integer",
            "format": "int64"
          },
          "runId": {
            "type": "string",
            "format": "uuid"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "eventType": {
            "type": "string",
            "enum": [
              "ITEM_VIEW"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ErrorInfo": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "errors"
        ],
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "message",
                "httpStatusCodes",
                "suggestedUserActions",
                "suggestedApplicationActions"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "httpStatusCodes": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                },
                "suggestedUserActions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "suggestedApplicationActions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
