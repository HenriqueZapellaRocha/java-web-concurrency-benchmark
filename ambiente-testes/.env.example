# Configuração de desenvolvimento e parâmetros congelados de CPU.
POSTGRES_DB=tcc2
POSTGRES_USER=tcc2
POSTGRES_PASSWORD=tcc2_local
POSTGRES_PORT=5432
APP_PORT=8080
APP_CPUS=2.0
APP_MEMORY=2g
POSTGRES_CPUS=2.0
POSTGRES_MEMORY=2g
POSTGRES_MAX_CONNECTIONS=100
JVM_HEAP=512m
CPU_ITERATIONS=200000
# M3 only: event-loop or bounded-elastic.
CPU_EXECUTION_MODE=event-loop
# M1: baseline explícito; campanhas de sensibilidade sobrescrevem por rodada.
TOMCAT_MAX_THREADS=200
TOMCAT_MIN_SPARE_THREADS=10
MIXED_CPU_ITERATIONS=10000
# M3 only: event-loop or bounded-elastic.
MIXED_CPU_EXECUTION_MODE=event-loop
# k6 de /cpu. O estudo oficial usa a matriz registrada no protocolo PBKDF2.
K6_CPU_RATE=25
K6_CPU_WARMUP_RATE=25
K6_CPU_TIME_UNIT=1s
K6_CPU_WARMUP_DURATION=30s
K6_CPU_MEASUREMENT_DURATION=60s
K6_CPU_PRE_ALLOCATED_VUS=100
K6_CPU_MAX_VUS=1000
K6_CPU_REQUEST_TIMEOUT=15s
# k6 de /io. Os valores são de piloto; a matriz oficial será congelada após calibração.
DB_POOL_MAX_SIZE=10
IO_DATABASE_DELAY=0ms
K6_IO_RATE=100
K6_IO_WARMUP_RATE=100
K6_IO_TIME_UNIT=1s
K6_IO_WARMUP_DURATION=30s
K6_IO_MEASUREMENT_DURATION=60s
K6_IO_PRE_ALLOCATED_VUS=100
K6_IO_MAX_VUS=1000
K6_IO_REQUEST_TIMEOUT=15s

